{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nam-aa-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "Namaa.Api",
    "Audience": "Namaa.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "FileStorage": {
    "Provider": "Local",
    "MaxFileSizeBytes": 26214400,
    "BlockedExtensions": [
      ".exe",
      ".dll",
      ".bat",
      ".cmd",
      ".ps1",
      ".sh",
      ".js",
      ".html",
      ".htm"
    ],
    "BlockedContentTypes": [
      "application/x-msdownload",
      "application/x-dosexec",
      "application/javascript",
      "text/javascript",
      "text/html",
      "application/x-sh"
    ]
  },
  "AllowedHosts": "*"
}
